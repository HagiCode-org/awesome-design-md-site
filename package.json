{
  "name": "awesome-design-md-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "pnpm run prepare:i18n && astro dev --host 0.0.0.0 --port ${PORT_WEBSITE:-4321}",
    "start": "pnpm run prepare:i18n && astro dev --host 0.0.0.0",
    "build": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; export NODE_ENV=\"${NODE_ENV:-production}\"; pnpm run prepare:i18n && pnpm run previews:verify && astro build && node ./scripts/verify-promoto-build.mjs && node ./scripts/verify-footer-build.mjs",
    "preview": "astro preview --host 0.0.0.0 --port ${PORT_WEBSITE:-4321}",
    "previews:render": "node ./scripts/render-preview-images.mjs",
    "previews:verify": "node ./scripts/verify-preview-images.mjs",
    "astro": "astro",
    "i18n:audit": "hagi18n audit --config hagi18n.yaml",
    "i18n:report": "hagi18n report --config hagi18n.yaml",
    "i18n:doctor": "hagi18n doctor --config hagi18n.yaml",
    "i18n:sync": "hagi18n sync --config hagi18n.yaml --from en-US --dry-run",
    "i18n:sync:write": "hagi18n sync --config hagi18n.yaml --from en-US --write",
    "i18n:prune": "hagi18n prune --config hagi18n.yaml --from en-US --dry-run",
    "i18n:prune:write": "hagi18n prune --config hagi18n.yaml --from en-US --write",
    "i18n:generate": "node ./scripts/generate-i18n-resources.mjs",
    "prepare:i18n": "pnpm run i18n:generate",
    "i18n:check": "pnpm run i18n:audit && pnpm run i18n:doctor && pnpm run prepare:i18n && node ./scripts/generate-i18n-resources.mjs --check",
    "test": "pnpm run prepare:i18n && vitest run",
    "typecheck": "export NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=8192\"; pnpm run prepare:i18n && astro check",
    "clean": "rm -rf .astro dist",
    "check:registry": "node scripts/check-registry-neutrality.mjs",
    "test:registry": "node --test scripts/check-registry-neutrality.node-test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^5.0.1",
    "@hagicode/hagilight": "0.20.0",
    "@hagicode/hagilight-core": "0.20.0",
    "astro": "^7.3.8",
    "mdast-util-to-string": "^4.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/commit-mono": "5.3.0",
    "@hagicode/hagi18n": "^0.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.0.2",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.16.1"
  }
}
