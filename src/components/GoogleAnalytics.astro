---
/**
 * Google Analytics 4 page-view bootstrap.
 * Mirrors the HagiCode standard analytics integration (site/docs):
 * loads only in production builds (import.meta.env.PROD).
 */
const measurementId = 'G-EN03FMT2Q4';
const shouldRender = import.meta.env.PROD;
const googleAnalyticsScriptUrl =
  `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
---

{shouldRender && (
  <>
    <script async src={googleAnalyticsScriptUrl}></script>
    <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${measurementId}');`}></script>
  </>
)}
