---
import { localeCopy, type SupportedLocale } from '@/config/site';

interface NavEntry {
  slug: string;
  title: string;
  href?: string;
}

interface Props {
  previous?: NavEntry;
  next?: NavEntry;
  locale?: SupportedLocale;
}

const { previous, next, locale = 'en' } = Astro.props;
const copy = localeCopy[locale].adjacent;
---

<nav class="detail-adjacent-nav" aria-label={copy.ariaLabel}>
  {
    previous ? (
      <a
        class="detail-adjacent-link"
        href={previous.href ?? `/designs/${previous.slug}/`}
        data-adjacent-link="previous"
        aria-keyshortcuts="ArrowLeft"
      >
        <span>
          <kbd aria-hidden="true">←</kbd>
          {copy.previous}
        </span>
        <strong>{previous.title}</strong>
      </a>
    ) : (
      <div class="detail-adjacent-link is-empty" aria-hidden="true" />
    )
  }

  {
    next ? (
      <a
        class="detail-adjacent-link detail-adjacent-link-next"
        href={next.href ?? `/designs/${next.slug}/`}
        data-adjacent-link="next"
        aria-keyshortcuts="ArrowRight"
      >
        <span>
          {copy.next}
          <kbd aria-hidden="true">→</kbd>
        </span>
        <strong>{next.title}</strong>
      </a>
    ) : (
      <div class="detail-adjacent-link is-empty" aria-hidden="true" />
    )
  }
</nav>
