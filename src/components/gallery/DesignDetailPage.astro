---
import AdjacentNavigation from '@/components/gallery/AdjacentNavigation.astro';
import DocumentTabs from '@/components/gallery/DocumentTabs.astro';
import HagiCodeShowcase from '@/components/gallery/HagiCodeShowcase';
import PreviewSwitcher from '@/components/gallery/PreviewSwitcher.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getDetailDescription,
  getLocaleHomePath,
  localeCopy,
  toLocalePath,
  toAbsoluteSiteUrl,
  type SupportedLocale,
} from '@/config/site';
import type { AwesomeDesignEntry } from '@/lib/content/awesomeDesignCatalog';

interface NavEntry {
  slug: string;
  title: string;
}

interface Props {
  locale: SupportedLocale;
  entry: AwesomeDesignEntry;
  previous?: NavEntry;
  next?: NavEntry;
}

const { locale, entry, previous, next } = Astro.props;
const copy = localeCopy[locale];
const currentPath = toLocalePath(`/designs/${entry.slug}/`, locale);
// Only English pages can use the brand-specific English excerpt from DESIGN.md;
// localized pages keep their translated template instead of mixing languages.
const description =
  locale === 'en' ? entry.seoDescription : getDetailDescription(locale, entry.title);
const previousEntry = previous
  ? { ...previous, href: toLocalePath(`/designs/${previous.slug}/`, locale) }
  : undefined;
const nextEntry = next
  ? { ...next, href: toLocalePath(`/designs/${next.slug}/`, locale) }
  : undefined;
const galleryHref = getLocaleHomePath(locale);
const pageUrl = toAbsoluteSiteUrl(currentPath, Astro.site);
const galleryUrl = toAbsoluteSiteUrl(galleryHref, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: copy.home.title,
      item: galleryUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: entry.title,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout
  title={`${entry.title} DESIGN.md • ${copy.detail.pageTitleSuffix}`}
  description={description}
  lang={locale}
  currentPath={currentPath}
  structuredData={structuredData}
>
  <section class="container detail-shell">
    <div class="detail-header shell-panel">
      <div class="detail-header-bar">
        <a class="detail-back-link" href={galleryHref}>
          {copy.detail.backToGallery}
        </a>
        <div
          class="segmented detail-layout-toggle"
          role="group"
          aria-label={copy.detail.layoutLabel}
        >
          <button type="button" class="preview-toggle is-active" data-detail-layout="split" aria-pressed="true">
            {copy.detail.layoutSplit}
          </button>
          <button type="button" class="preview-toggle" data-detail-layout="preview" aria-pressed="false">
            {copy.detail.layoutPreview}
          </button>
          <button type="button" class="preview-toggle" data-detail-layout="docs" aria-pressed="false">
            {copy.detail.layoutDocs}
          </button>
        </div>
      </div>
      <div class="detail-header-copy">
        <h1>{entry.title}</h1>
        <p class="detail-summary">{entry.summary}</p>
      </div>
    </div>

    <div class="detail-grid" data-detail-grid data-layout="split">
      <script is:inline>
        // Restore the saved layout before first paint so the grid does not jump.
        try {
          const saved = localStorage.getItem('adms-detail-layout');
          if (saved === 'preview' || saved === 'docs') {
            document.currentScript.parentElement.dataset.layout = saved;
          }
        } catch {}
      </script>
      <PreviewSwitcher
        title={entry.title}
        lightUrl={entry.preview.lightUrl}
        darkUrl={entry.preview.darkUrl}
        hasDedicatedDark={entry.preview.hasDedicatedDark}
        locale={locale}
      />

      <DocumentTabs
        readmeHtml={entry.readmeHtml}
        designHtml={entry.designHtml}
        designMarkdown={entry.designMarkdown}
        designDownloadUrl={entry.designDownloadUrl}
        locale={locale}
      />
    </div>

    <AdjacentNavigation previous={previousEntry} next={nextEntry} locale={locale} />
    <HagiCodeShowcase locale={locale} client:load />
  </section>
</BaseLayout>

<script>
  import { initializeDetailWorkbench } from '@/components/gallery/detail-workbench';

  initializeDetailWorkbench();
</script>
