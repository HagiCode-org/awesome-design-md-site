---
import { localeCopy, type SupportedLocale } from '@/config/site';
import { interpolate } from '@/i18n';

interface Props {
  title: string;
  lightUrl: string;
  darkUrl: string;
  hasDedicatedDark: boolean;
  locale?: SupportedLocale;
}

const { title, lightUrl, darkUrl, hasDedicatedDark, locale = 'en' } = Astro.props;
const copy = localeCopy[locale].preview;
---

<section
  class="preview-switcher shell-panel"
  data-preview-switcher
  data-light-url={lightUrl}
  data-dark-url={darkUrl}
>
  <div class="preview-switcher-head">
    <h2>{copy.heading}</h2>
    <div class="preview-switcher-tools">
      <div class="segmented" role="group" aria-label={copy.themeTabLabel}>
        <button type="button" class="preview-toggle is-active" data-preview-variant="light" aria-pressed="true">
          {copy.light}
        </button>
        <button
          type="button"
          class="preview-toggle"
          data-preview-variant="dark"
          aria-pressed="false"
          title={hasDedicatedDark ? copy.openDarkTitle : copy.fallbackDarkTitle}
        >
          {copy.dark}
        </button>
      </div>
      <div class="segmented preview-viewport-group" role="group" aria-label={copy.viewportLabel}>
        <button type="button" class="preview-toggle is-active" data-preview-viewport="fit" aria-pressed="true">
          {copy.viewportFit}
        </button>
        <button type="button" class="preview-toggle" data-preview-viewport="tablet" aria-pressed="false">
          {copy.viewportTablet}
        </button>
        <button type="button" class="preview-toggle" data-preview-viewport="mobile" aria-pressed="false">
          {copy.viewportMobile}
        </button>
      </div>
      <a
        class="preview-open"
        data-preview-open
        href={lightUrl}
        target="_blank"
        rel="noopener"
        aria-label={copy.openInTab}
        title={copy.openInTab}
      >
        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true">
          <path d="M6 3H3v10h10v-3" />
          <path d="M9 2.5h4.5V7" />
          <path d="M13.5 2.5 7.5 8.5" />
        </svg>
      </a>
    </div>
  </div>

  <div class="preview-stage" data-preview-stage data-state="loading" aria-busy="true">
    <iframe
      class="detail-preview-frame"
      title={interpolate(copy.frameTitle, { title })}
      sandbox="allow-same-origin allow-scripts"
      data-preview-frame></iframe>
  </div>

  <p class="preview-switcher-foot">
    <span class="preview-switcher-note">
      {hasDedicatedDark ? copy.bothAvailableNote : copy.fallbackNote}
    </span>
    <output class="preview-width-readout" data-preview-width aria-hidden="true"></output>
  </p>
</section>

<script>
  import { initializePreviewSwitchers } from '@/components/gallery/preview-switcher';

  initializePreviewSwitchers();
</script>
